+
+export function measureDiagnostic(name: string, fields: DiagnosticFields = {}) {
+  const at = now();
+  let finished = false;
+  return (outcome: Outcome = "ok", extra: DiagnosticFields = {}): void => {
+    if (finished) return;
+    finished = true;
+    recordDiagnostic(name, {
+      ...fields,
+      ...extra,
+      elapsedMs: Math.max(0, now() - at),
+      error: outcome === "error",
+      cancelled: outcome === "cancelled",
+    });
+  };
