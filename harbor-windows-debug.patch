@@ -0,0 +1,60 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import ts from "typescript";
+
+test("profile/account/session and local-library mutations invalidate caches and notify mounted consumers", () => {
+  const callbacks = new Map();
+  let cw = [];
+  const subscribe = (name) => (fn) => callbacks.set(name, fn);
+  const mocks = {
+    "./active-profile-id": {
+      activeScopedProfileId: () => "profile",
+      nuvioWatchedScope: () => "owner",
+    },
+    "./trakt/session": { subscribeSession: subscribe("trakt") },
+    "./simkl/session": { subscribeSession: subscribe("simkl") },
+    "./watchlist": { subscribeWatchlist: subscribe("watchlist") },
+    "./local-cw": { subscribeLocalCw: subscribe("cw"), listLocalCw: () => cw },
+    "./manual-watched": { subscribeManualWatched: subscribe("watched") },
+  };
+  const api = {};
+  const code = ts.transpileModule(readFileSync("src/lib/calendar-cache-scope.ts", "utf8"), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+  }).outputText;
+  new Function("require", "exports", "window", code)((id) => mocks[id], api, {
+    addEventListener: (name, fn) => callbacks.set(name, fn),
+  });
+  let clears = 0,
+    updates = 0;
+  api.registerCalendarCache(() => clears++);
+  const unsubscribe = api.subscribeCalendarCache(() => updates++);
+  for (const name of [
+    "trakt",
+    "simkl",
+    "watchlist",
+    "cw",
+    "watched",
+    "harbor:active-profile-changed",
+    "harbor:account-provider-changed",
+    "harbor:nuvio-state-changed",
+    "storage",
+  ]) {
+    const previous = api.calendarScopeKey();
+    if (name === "cw")
+      cw = [{ id: "series-one", type: "series", season: 1, episode: 2, positionMs: 1000 }];
+    callbacks.get(name)();
+    assert.notEqual(api.calendarScopeKey(), previous, name);
+  }
+  assert.equal(clears, 9);
+  assert.equal(updates, 9);
+  cw = cw.map((entry) => ({ ...entry, positionMs: 5000, t: 12345 }));
+  callbacks.get("cw")();
+  assert.equal(clears, 9, "position-only autosave keeps calendar cache warm");
+  cw = cw.map((entry) => ({ ...entry, episode: 3 }));
+  callbacks.get("cw")();
+  assert.equal(clears, 10, "episode membership changes invalidate calendar");
+  unsubscribe();
+  api.invalidateCalendarCaches();
+  assert.equal(updates, 10);
+});
diff --git a/tests/calendar-cache.test.mjs b/tests/calendar-cache.test.mjs
new file mode 100644
index 00000000..6f5bde57
--- /dev/null
+++ b/tests/calendar-cache.test.mjs
@@ -0,0 +1,120 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { CalendarCache } from "../src/lib/calendar-cache.ts";
+import { mapCalendarLimit } from "../src/lib/calendar-scheduler.ts";
+
+const deferred = () => {
+  let resolve, reject;
+  const promise = new Promise((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+};
+
+test("warm results and overlapping requests avoid repeat fetches; failures can retry", async () => {
+  const cache = new CalendarCache(3, 10000);
+  let calls = 0;
+  const wait = deferred();
+  const fetcher = () => {
+    calls++;
+    return wait.promise;
+  };
+  const one = cache.fetch("one", fetcher);
+  const two = cache.fetch("one", fetcher);
+  assert.equal(one, two);
+  wait.resolve([1]);
+  assert.deepEqual(await one, [1]);
+  assert.deepEqual(await cache.fetch("one", fetcher), [1]);
+  assert.equal(calls, 1);
+  await assert.rejects(
+    cache.fetch("failed", async () => {
+      throw new Error("failed");
+    }),
+  );
+  assert.equal(await cache.fetch("failed", async () => 2), 2);
+});
+
+test("clear fences stale writes and stale cleanup cannot remove replacement inflight work", async () => {
+  const cache = new CalendarCache(3, 10000);
+  const old = deferred(),
+    fresh = deferred();
+  const first = cache.fetch("same", () => old.promise);
+  cache.clear();
+  const second = cache.fetch("same", () => fresh.promise);
+  old.resolve("old");
+  assert.equal(await first, "old");
+  assert.equal(cache.peek("same"), undefined);
+  assert.equal(
+    cache.fetch("same", () => {
+      throw new Error("duplicate");
+    }),
+    second,
+  );
+  fresh.resolve("fresh");
+  await second;
+  assert.equal(cache.peek("same"), "fresh");
+});
+
+test("results, pending requests, and TTL remain bounded", async () => {
+  const cache = new CalendarCache(2, 10000);
+  await cache.fetch("a", async () => "a");
+  await cache.fetch("b", async () => "b");
+  cache.peek("a");
+  await cache.fetch("c", async () => "c");
+  assert.equal(cache.peek("b"), undefined);
+  assert.equal(cache.peek("a"), "a");
+  const expired = new CalendarCache(2, -1);
+  await expired.fetch("x", async () => 1);
+  assert.equal(expired.peek("x"), undefined);
+  assert.equal(await expired.fetch("x", async () => 2), 2);
+});
+
+test("slot scheduler respects the concurrency bound and input ordering", async () => {
+  let active = 0,
+    peak = 0;
+  const gates = Array.from({ length: 8 }, deferred);
+  const work = mapCalendarLimit(gates, 3, async (gate) => {
+    peak = Math.max(peak, ++active);
+    const result = await gate.promise;
+    active--;
+    return result;
+  });
+  assert.equal(active, 3);
+  gates.forEach((gate, index) => gate.resolve(index));
+  assert.deepEqual(await work, [0, 1, 2, 3, 4, 5, 6, 7]);
+  assert.equal(peak, 3);
+});
+
+test("evicted pending writes cannot overwrite newer requests for the same key", async () => {
+  const cache = new CalendarCache(1, 10000);
+  const old = deferred(),
+    other = deferred(),
+    fresh = deferred();
+  const first = cache.fetch("a", () => old.promise);
+  const second = cache.fetch("b", () => other.promise);
+  const third = cache.fetch("a", () => fresh.promise);
+  fresh.resolve("fresh");
+  await third;
+  old.resolve("old");
+  other.resolve("other");
+  await Promise.all([first, second]);
+  assert.equal(cache.peek("a"), "fresh");
+});
+
+test("public source cache keeps stale rows during one background refresh", async () => {
+  const cache = new CalendarCache(2, -1, true);
+  await cache.fetch("a", async () => "old");
+  const fresh = deferred();
+  let calls = 0;
+  const fetcher = () => {
+    calls++;
+    return fresh.promise;
+  };
+  assert.equal(await cache.fetch("a", fetcher), "old");
+  assert.equal(await cache.fetch("a", fetcher), "old");
+  assert.equal(calls, 1);
+  fresh.resolve("new");
+  for (let i = 0; i < 10; i++) await Promise.resolve();
+  assert.equal(await cache.fetch("a", async () => "next"), "new");
+});
diff --git a/tests/calendar-data-hook.test.mjs b/tests/calendar-data-hook.test.mjs
new file mode 100644
index 00000000..b8db57fa
--- /dev/null
+++ b/tests/calendar-data-hook.test.mjs
@@ -0,0 +1,185 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { hookHarness, flushPromises } from "./helpers/hook-harness.ts";
+import { CalendarCache } from "../src/lib/calendar-cache.ts";
+
+const deferred = () => {
+  let resolve;
+  const promise = new Promise((yes) => {
+    resolve = yes;
+  });
+  return { promise, resolve };
+};
+
+function fixture() {
+  let scope = "one",
+    revision = 0;
+  const clearers = [];
+  const calls = [];
+  const mocks = {
+    "@/lib/calendar-cache": { CalendarCache },
+    "@/lib/calendar-cache-scope": {
+      calendarScopeKey: () => scope,
+      calendarCacheRevision: () => revision,
+      subscribeCalendarCache: () => () => {},
+      registerCalendarCache: (clear) => clearers.push(clear),
+    },
+    "@/lib/perf/diagnostics": { recordDiagnostic() {}, measureDiagnostic: () => () => {} },
+    "@/lib/i18n": { t: (s) => s },
+    "@/lib/calendar": {
+      monthRangeISO: () => ({ start: "2026-10-01", end: "2026-10-31" }),
+      fetchCalendarRange: () => Promise.resolve([]),
+      fetchCustomCalendar: (opts) => {
+        calls.push({ source: "custom", opts });
+        return Promise.resolve([]);
+      },
+    },
+    "@/lib/calendar-sources": Object.fromEntries(
+      [
+        "Library",
+        "Trakt",
+        "Simkl",
+        "SimklPremieres",
+        "Anticipated",
+        "AniListAiring",
+        "AnimeDub",
+      ].map((name) => [
+        `fetch${name}Calendar`,
+        (...args) => {
+          const wait = deferred();
+          calls.push({ source: name, args, wait });
+          return wait.promise;
+        },
+      ]),
+    ),
+  };
+  const source = "src/views/calendar/use-calendar-data.ts";
+  // Separate harnesses execute the module afresh; share its cache to model real remounts.
+  const sharedCache = new CalendarCache(18, 300000);
+  mocks["@/lib/calendar-cache"].CalendarCache = class {
+    constructor() {
+      return sharedCache;
+    }
+  };
+  const create = () => hookHarness(source, "useCalendarData", mocks);
+  const args = {
+    source: "library",
+    authKey: "auth",
+    traktConnected: true,
+    simklConnected: false,
+    year: 2026,
+    month: 9,
+    animeDub: false,
+    settings: {
+      tmdbKey: "tmdb",
+      tmdbLanguage: "en",
+      region: "US",
+      customCalendar: {
+        trackedPeople: [],
+        genres: [],
+        watchProviders: [],
+        originCountries: [],
+        mediaTypes: { movie: true, tv: true, anime: true },
+      },
+    },
+  };
+  return {
+    create,
+    args,
+    calls,
+    invalidate(next = scope) {
+      scope = next;
+      revision++;
+      clearers.forEach((clear) => clear());
+    },
+  };
+}
+
+test("remount coalesces pending work and reuses warm rows", async () => {
+  const f = fixture();
+  const first = f.create();
+  first.render(f.args);
+  await flushPromises();
+  first.unmount();
+  const second = f.create();
+  second.render(f.args);
+  await flushPromises();
+  assert.equal(f.calls.length, 1);
+  f.calls[0].wait.resolve([{ id: "one" }]);
+  await flushPromises();
+  assert.deepEqual(second.render(f.args).items, [{ id: "one" }]);
+  second.unmount();
+  const third = f.create();
+  const warm = third.render(f.args);
+  await flushPromises();
+  assert.deepEqual(warm.items, [{ id: "one" }]);
+  assert.equal(warm.loading, false);
+  assert.equal(f.calls.length, 1);
+  third.unmount();
+});
+
+test("month/source/account changes hide old rows immediately and reject late completion", async () => {
+  const f = fixture();
+  const h = f.create();
+  h.render(f.args);
+  await flushPromises();
+  const next = { ...f.args, month: 10 };
+  assert.deepEqual(h.render(next).items, []);
+  await flushPromises();
+  f.calls[0].wait.resolve([{ id: "old" }]);
+  await flushPromises();
+  assert.deepEqual(h.render(next).items, []);
+  f.calls[1].wait.resolve([{ id: "new" }]);
+  await flushPromises();
+  assert.deepEqual(h.render(next).items, [{ id: "new" }]);
+  f.invalidate("other-account");
+  assert.deepEqual(h.render(next).items, []);
+  await flushPromises();
+  assert.equal(f.calls.length, 3);
+  const trakt = { ...next, source: "trakt" };
+  assert.deepEqual(h.render(trakt).items, []);
+  await flushPromises();
+  assert.equal(f.calls[3].source, "Trakt");
+  h.unmount();
+});
+
+test("all custom filters refetch; base starts with pending extras", async () => {
+  const f = fixture();
+  const h = f.create();
+  let args = {
+    ...f.args,
+    source: "custom",
+    settings: {
+      ...f.args.settings,
+      customCalendar: {
+        ...f.args.settings.customCalendar,
+        includeTraktAnticipated: true,
+      },
+    },
+  };
+  h.render(args);
+  await flushPromises();
+  assert.deepEqual(
+    f.calls.map((c) => c.source),
+    ["Anticipated", "custom"],
+  );
+  assert.ok(f.calls[1].opts.extra instanceof Promise);
+  for (const [key, value] of Object.entries({
+    genres: [{ id: 1, mediaType: "movie" }],
+    watchProviders: [{ id: 1 }],
+    originCountries: ["GB"],
+    mediaTypes: { movie: false, tv: true, anime: false },
+  })) {
+    args = {
+      ...args,
+      settings: {
+        ...args.settings,
+        customCalendar: { ...args.settings.customCalendar, [key]: value },
+      },
+    };
+    h.render(args);
+    await flushPromises();
+  }
+  assert.equal(f.calls.filter((c) => c.source === "custom").length, 5);
+  h.unmount();
+});
