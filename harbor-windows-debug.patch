+  api.clearCalendarSourceCache();
+  assert.equal(dependentClears, 1);
+  await fetch("new key");
+  assert.equal(calls, 5);
+  connected = false;
+  assert.deepEqual(await fetch(), []);
+  assert.equal(calls, 5);
+});
